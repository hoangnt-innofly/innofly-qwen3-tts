APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000

# 1 = placeholder wav (no GPU). 0 = real Qwen3-TTS.
TTS_MOCK=0

TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
TTS_DEVICE_MAP=cuda:0
TTS_DTYPE=bfloat16
# sdpa is portable. Use flash_attention_2 after installing flash-attn.
TTS_ATTN_IMPLEMENTATION=sdpa

TTS_DEFAULT_LANGUAGE=Auto
TTS_DEFAULT_SPEAKER=Vivian
TTS_DEFAULT_INSTRUCT=
TTS_DEFAULT_TEMPERATURE=0.9
TTS_DEFAULT_TOP_K=50
TTS_DEFAULT_TOP_P=1.0
TTS_DEFAULT_REPETITION_PENALTY=1.05
TTS_DEFAULT_MAX_NEW_TOKENS=2048
TTS_DEFAULT_DO_SAMPLE=1
TTS_DEFAULT_SEED=42

MAX_TEXT_CHARS=4000
JOB_TTL_SECONDS=86400

# 1 = after each job, unload the GPU model (reload on next generate).
# Needed on the shared 12GB card. Set 0 only if TTS owns the GPU.
TTS_FREE_VRAM=1

PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
