APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Required on every /api/v1/* call as header: api-key: <this value>
SECRET_API_KEY=change-me

# 1 = placeholder wav (no GPU needed). 0 = real GPU inference.
TTS_MOCK=0

# Engine: omnivoice (VoiceStudio 646 languages) or qwen3
TTS_ENGINE=omnivoice

# Model ID (Hugging Face ID or local path in ./models)
TTS_MODEL_ID=k2-fsa/OmniVoice

TTS_DEVICE_MAP=cuda:0
TTS_DTYPE=float16
TTS_ATTN_IMPLEMENTATION=sdpa

# OmniVoice diffusion parameters
TTS_NUM_STEP=16
TTS_SPEED=1.0
TTS_GUIDANCE_SCALE=2.0

# General TTS defaults
TTS_DEFAULT_LANGUAGE=Auto
TTS_DEFAULT_SPEAKER=Default
TTS_DEFAULT_INSTRUCT=
TTS_DEFAULT_TEMPERATURE=0.9
TTS_DEFAULT_TOP_K=50
TTS_DEFAULT_TOP_P=1.0
TTS_DEFAULT_REPETITION_PENALTY=1.05
TTS_DEFAULT_MAX_NEW_TOKENS=2048
TTS_DEFAULT_DO_SAMPLE=1
TTS_DEFAULT_SEED=42

TTS_SUBTALKER_TEMPERATURE=0.6
TTS_SUBTALKER_TOP_K=50
TTS_SUBTALKER_TOP_P=0.9
TTS_STABLE_TEMPERATURE=0.6
TTS_STABLE_TOP_P=0.85
TTS_STABLE_REPETITION_PENALTY=1.1
TTS_MAX_ATTEMPTS=3

MAX_TEXT_CHARS=8000
JOB_TTL_SECONDS=86400

# 1 = after each job, park weights in RAM / free VRAM for other GPU tasks.
TTS_FREE_VRAM=1

PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
